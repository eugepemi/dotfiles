// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry",
      "default_model": "eu.anthropic.claude-opus-4-6-v1"
    }
  },
  "icon_theme": "Catppuccin Macchiato",
  // AI Assistant Settings
  "agent": {
    "dock": "right",
    "default_model": {
      "effort": "high",
      "provider": "amazon-bedrock",
      "model": "claude-opus-4-8",
      "enable_thinking": true
    },
    "favorite_models": [],
    "default_profile": "write",
    "model_parameters": []
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Macchiato",
  },
  // Language-Specific Settings
  "languages": {
    "Python": {
      "completions": {
        "lsp": true,
        "words": "fallback",
      },
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.fixAll.ruff" },
        { "code_action": "source.organizeImports.ruff" },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
      "language_servers": [
        // "pyright",
        // "basedpyright
        //"pylsp",
        //"python-refactoring",
        "ty",
        "ruff",
      ],
    },
  },
  // LSP (Language Server Protocol) Settings
  "lsp": {
    "pyright": {
      "settings": {
        "python.analysis": {
          "diagnosticMode": "openFilesOnly",
          "typeCheckingMode": "basic",
        },
        "disableOrganizeImports": true,
      },
    },
    "basedpyright": {
      "settings": {
        "python": {
          "reportMissingTypeStubs": false,
        },
        "basedpyright.analysis": {
          "diagnosticMode": "openFilesOnly",
          "typeCheckingMode": "basic",
          "reportMissingTypeStubs": false,
        },
        "disableOrganizeImports": true,
      },
    },
    "pylsp": {
      "settings": {
        "plugins": {
          "autopep8": {
            "enabled": false,
          },
          "black": {
            "enabled": false,
          },
          "flake8": {
            "enabled": false,
          },
          "isort": {
            "enabled": false,
          },
          "mccabe": {
            "enabled": false,
          },
          "pycodestyle": {
            "enabled": false,
          },
          "pydocstyle": {
            "enabled": false,
          },
          "pyflakes": {
            "enabled": false,
          },
          "pylint": {
            "enabled": false,
          },
          "yapf": {
            "enabled": false,
          },
          // keep the others
          "pylsp_mypy": {
            "enabled": true,
          },
          "jedi": {
            "enabled": true,
          },
          "rope": {
            "enabled": true,
          },
          "rope_autoimport": {
            "enabled": true,
          },
          "rope_completion": {
            "enabled": true,
          },
          // disable pylsp ruff in favor of `ruff server`
          "ruff": {
            "enabled": false,
          },
        },
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 88,
          "showSyntaxErrors": true,
          "lint": {
            "select": ["COM812", "E4", "E7", "E9", "F", "I"],
            "ignore": ["D", "S101", "ANN201"],
          },
        },
      },
    },
  },
  // Jupyter Settings
  "jupyter": {
    "kernel_selections": {
      "python": "/Users/eugenio.penalver/.local/pipx/venvs/ipykernel/share/jupyter/kernels/python3",
    },
  },
  // Telemetry Settings
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  // Font Settings
  "buffer_font_family": "Hack Nerd Font",
  "buffer_font_size": 17,
  "buffer_font_features": {
    "calt": true,
    "dlig": true,
  },
  "ui_font_family": "Hack Nerd Font",
  "ui_font_size": 19,
  "ui_font_weight": 600,
  "ui_font_features": {
    "calt": true,
  },
  "ui_font_fallbacks": ["Hack Nerd Font"],
}
